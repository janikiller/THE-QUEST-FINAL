; Engine configuration file.
; Godot 4.7.2 — THE QUEST FINAL: Comisaría
config_version=5

[application]

config/name="THE QUEST FINAL — Comisaría"
config/description="Gestiona una comisaría: mapa de ciudad, misiones y despacho de patrullas por radio."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CharacterDB="*res://autoload/character_db.gd"
LocationDB="*res://autoload/location_db.gd"
CardDB="*res://autoload/card_db.gd"
ItemDB="*res://autoload/item_db.gd"
AudioDirector="*res://autoload/audio_director.gd"
GameState="*res://autoload/game_state.gd"
RadioBus="*res://autoload/radio_bus.gd"
RoadNav="*res://autoload/road_nav.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

